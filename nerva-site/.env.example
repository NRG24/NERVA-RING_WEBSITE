# Copy to `.env.local` and fill in. Vite only exposes vars prefixed with VITE_.

# Where the "Follow the build" form POSTs { "email": "..." } as JSON.
# Any of these work — pick one and paste its endpoint URL:
#   Buttondown   https://buttondown.email/api/emails/embed-subscribe/<username>
#   Formspree    https://formspree.io/f/<form-id>
#   ConvertKit   https://api.convertkit.com/v3/forms/<form-id>/subscribe
#   Your own     e.g. a Cloudflare Worker / Vercel function
#
# Leave it unset and the form will say signup isn't connected yet
# (rather than pretending to succeed and silently dropping the address).
VITE_SIGNUP_ENDPOINT=

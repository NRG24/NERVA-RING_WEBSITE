# Copy to `.env.local` and fill in. Vite only exposes vars prefixed with VITE_.

# Where the "Follow the build" form POSTs { "email": "..." } as JSON.
# Any of these work — pick one and paste its endpoint URL:
#   Buttondown   https://buttondown.email/api/emails/embed-subscribe/<username>
#   Formspree    https://formspree.io/f/<form-id>
#   ConvertKit   https://api.convertkit.com/v3/forms/<form-id>/subscribe
#   Your own     e.g. a Cloudflare Worker / Vercel function
#
# Leave it unset and the form will say signup isn't connected yet
# (rather than pretending to succeed and silently dropping the address).
VITE_SIGNUP_ENDPOINT=


# ---------------------------------------------------------------------------
# Store preview at /buy.html. Leave these unset and the page renders its
# placeholder product with the buy button switched off. Set both and it pulls
# the live title, options, price, and stock from Shopify, and the button opens
# a real Shopify checkout.
#
# Get the token from: Shopify admin > Sales channels > Headless > create a
# storefront > "Public access token". That token is meant for browser code.
# The Admin API token is not: never put it in a VITE_ var, since anything
# prefixed VITE_ is compiled into the JavaScript everyone downloads.
VITE_SHOPIFY_DOMAIN=            # e.g. nerva-ring.myshopify.com (no https://)
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Optional. Storefront API versions ship quarterly and each is good for a year;
# defaults to 2025-01. https://shopify.dev/docs/api/usage/versioning
VITE_SHOPIFY_API_VERSION=

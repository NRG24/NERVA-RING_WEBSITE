{
  "name": "nerva-ring-website",
  "compatibility_date": "2026-08-29",
  // The waitlist backend (worker/index.ts). It only runs for /api/*;
  // every other path is a static file out of dist, as before.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // an address the site does not have gets dist/404.html, with a 404
    // status, instead of Cloudflare's bare error page
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // public by design: it's in Kit's own form URL
    "KIT_FORM_ID": "10036721"
  },
  // The signup store. No database_id: the first `wrangler deploy` creates
  // the database and binds it. Pin the id it prints here afterwards so a
  // later deploy can never make a second, empty one.
  "d1_databases": [
    { "binding": "DB", "database_name": "nerva-waitlist" }
  ],
  "observability": { "enabled": true }
}

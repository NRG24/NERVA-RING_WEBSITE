# Cloudflare static-asset headers. https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  # No form-action on purpose. The signup form posts to app.kit.com, which can
  # redirect through other Kit hosts (a CAPTCHA page, then back here), and
  # browsers apply form-action to every hop. Blocking one would silently break
  # the only conversion on the site. Style stays 'unsafe-inline' because the
  # pages set style attributes (swatch colours, scrub progress).
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://*.myshopify.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# built files carry a content hash in their name, so they never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the sitemap and feed should show a new post within the hour
/sitemap.xml
  Cache-Control: public, max-age=3600
/updates.xml
  Cache-Control: public, max-age=3600
